{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AutoCompactSource": {
      "enum": [
        "provider",
        "global",
        "default"
      ],
      "type": "string"
    },
    "ContextPolicy": {
      "properties": {
        "autoCompactBaseTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "autoCompactSource": {
          "$ref": "#/definitions/AutoCompactSource"
        },
        "autoCompactTokenLimit": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "contextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "inputTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "inputTokensEstimated": {
          "type": "boolean"
        },
        "modelId": {
          "type": "string"
        },
        "pricing": {
          "$ref": "#/definitions/ContextPricing"
        },
        "providerId": {
          "type": "string"
        },
        "safeContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "autoCompactSource",
        "inputTokensEstimated",
        "modelId",
        "pricing",
        "providerId"
      ],
      "type": "object"
    },
    "ContextPricing": {
      "properties": {
        "inclusive": {
          "type": "boolean"
        },
        "inputTokenThreshold": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/PricingStatus"
        }
      },
      "required": [
        "inclusive",
        "status"
      ],
      "type": "object"
    },
    "PricingStatus": {
      "enum": [
        "confirmed",
        "reference",
        "no-surcharge",
        "unknown"
      ],
      "type": "string"
    },
    "ThreadTokenUsage": {
      "properties": {
        "contextPolicy": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}