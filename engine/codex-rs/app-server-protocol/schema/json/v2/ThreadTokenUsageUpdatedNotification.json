{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AutoCompactSource": {
      "enum": [
        "model",
        "provider",
        "global",
        "default"
      ],
      "type": "string"
    },
    "ContextPolicy": {
      "properties": {
        "autoCompactBaseTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "autoCompactSource": {
          "$ref": "#/definitions/AutoCompactSource"
        },
        "autoCompactTokenLimit": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "autoCompactionEnabled": {
          "default": true,
          "type": "boolean"
        },
        "contextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "inputTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "inputTokensEstimated": {
          "type": "boolean"
        },
        "modelId": {
          "type": "string"
        },
        "pricing": {
          "$ref": "#/definitions/ContextPricing"
        },
        "providerId": {
          "type": "string"
        },
        "safeContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "autoCompactSource",
        "inputTokensEstimated",
        "modelId",
        "pricing",
        "providerId"
      ],
      "type": "object"
    },
    "ContextPricing": {
      "properties": {
        "inclusive": {
          "type": "boolean"
        },
        "inputTokenThreshold": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/PricingStatus"
        }
      },
      "required": [
        "inclusive",
        "status"
      ],
      "type": "object"
    },
    "PricingStatus": {
      "enum": [
        "confirmed",
        "reference",
        "no-surcharge",
        "unknown"
      ],
      "type": "string"
    },
    "ResponseMinuteSample": {
      "properties": {
        "minute": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResponseSpeedMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "requestDurationMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "minute",
        "outputTokens",
        "requestDurationMs"
      ],
      "type": "object"
    },
    "ResponsePerformance": {
      "properties": {
        "completedRequests": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "graphEstimated": {
          "default": false,
          "type": "boolean"
        },
        "history": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ResponsePerformanceTurn"
          },
          "type": "array"
        },
        "minuteSamples": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ResponseMinuteSample"
          },
          "type": "array"
        },
        "observedAtUnixMs": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "requestDurationMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAtUnixMs": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "truncatedMinutes": {
          "default": false,
          "type": "boolean"
        },
        "turnId": {
          "type": "string"
        },
        "unmeasuredRequests": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "completedRequests",
        "outputTokens",
        "requestDurationMs",
        "turnId",
        "unmeasuredRequests"
      ],
      "type": "object"
    },
    "ResponsePerformanceTurn": {
      "properties": {
        "minuteSamples": {
          "items": {
            "$ref": "#/definitions/ResponseMinuteSample"
          },
          "type": "array"
        },
        "startedAtUnixMs": {
          "format": "int64",
          "type": "integer"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "minuteSamples",
        "startedAtUnixMs",
        "turnId"
      ],
      "type": "object"
    },
    "ResponseSpeedMode": {
      "enum": [
        "standard",
        "fast",
        "ultrafast"
      ],
      "type": "string"
    },
    "ThreadTokenUsage": {
      "properties": {
        "contextPolicy": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "responsePerformance": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResponsePerformance"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}