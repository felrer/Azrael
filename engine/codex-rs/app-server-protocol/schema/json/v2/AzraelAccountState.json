{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Account": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "apiKey"
              ],
              "title": "ApiKeyAccountType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "ApiKeyAccount",
          "type": "object"
        },
        {
          "properties": {
            "email": {
              "type": [
                "string",
                "null"
              ]
            },
            "planType": {
              "$ref": "#/definitions/PlanType"
            },
            "type": {
              "enum": [
                "chatgpt"
              ],
              "title": "ChatgptAccountType",
              "type": "string"
            }
          },
          "required": [
            "email",
            "planType",
            "type"
          ],
          "title": "ChatgptAccount",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "amazonBedrock"
              ],
              "title": "AmazonBedrockAccountType",
              "type": "string"
            },
            "usesCodexManagedCredentials": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "title": "AmazonBedrockAccount",
          "type": "object"
        }
      ]
    },
    "AzraelProfile": {
      "properties": {
        "autoSwitchAllowed": {
          "default": false,
          "type": "boolean"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "planType": {
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "type": "string"
        },
        "workspaceAccountId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "workspaceAccountId"
      ],
      "type": "object"
    },
    "PlanType": {
      "enum": [
        "free",
        "go",
        "plus",
        "pro",
        "prolite",
        "promax",
        "team",
        "self_serve_business_prolite",
        "self_serve_business_usage_based",
        "business",
        "ent26",
        "enterprise_cbp_automation",
        "enterprise_cbp_usage_based",
        "enterprise",
        "edu",
        "edu_plus",
        "edu_pro",
        "unknown"
      ],
      "type": "string"
    }
  },
  "properties": {
    "activeProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "codexHome": {
      "type": "string"
    },
    "currentAccount": {
      "anyOf": [
        {
          "$ref": "#/definitions/Account"
        },
        {
          "type": "null"
        }
      ]
    },
    "hasActiveTurns": {
      "type": "boolean"
    },
    "instanceId": {
      "type": "string"
    },
    "isSwitching": {
      "type": "boolean"
    },
    "lastError": {
      "type": [
        "string",
        "null"
      ]
    },
    "loginPending": {
      "type": "boolean"
    },
    "pendingProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "profiles": {
      "items": {
        "$ref": "#/definitions/AzraelProfile"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "codexHome",
    "hasActiveTurns",
    "instanceId",
    "isSwitching",
    "loginPending",
    "profiles",
    "revision"
  ],
  "title": "AzraelAccountState",
  "type": "object"
}