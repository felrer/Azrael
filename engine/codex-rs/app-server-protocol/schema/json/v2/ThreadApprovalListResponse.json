  "definitions": {
    "HostApprovalPersistence": {
      "enum": [
        "session",
        "always"
      ],
      "type": "string"
    },
    "HostApprovalRecord": {
      "properties": {
        "originalRootTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "originalTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": true,
        "persistence": {
          "anyOf": [
            {
              "$ref": "#/definitions/HostApprovalPersistence"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        },
        "resumeState": {
          "$ref": "#/definitions/HostApprovalResumeState"
        },
        "resumeTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopeKey": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/HostApprovalState"
        },
        "waiterDetached": {
          "type": "boolean"
