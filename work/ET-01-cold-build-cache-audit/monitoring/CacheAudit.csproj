<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreSources></RestoreSources><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="Microsoft.Diagnostics.Tracing.TraceEvent"><HintPath>$(DecoderPayload)/Microsoft.Diagnostics.Tracing.TraceEvent.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Diagnostics.FastSerialization"><HintPath>$(DecoderPayload)/Microsoft.Diagnostics.FastSerialization.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Diagnostics.NETCore.Client"><HintPath>$(DecoderPayload)/Microsoft.Diagnostics.NETCore.Client.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
