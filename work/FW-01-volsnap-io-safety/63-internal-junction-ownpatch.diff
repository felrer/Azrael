+            $value.StartsWith('\\?\') -or $value.StartsWith('\\.\') -or $value.Substring([IO.Path]::GetPathRoot($value).Length) -match '[:]|[. ]([\\/]|$)') { throw 'Internal junction paths must be plain canonical absolute paths.' }
+    }
