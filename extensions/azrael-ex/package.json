{
  "name": "azrael",
  "displayName": "Azrael",
  "description": "Independent Azrael chat, account, and usage extension.",
  "version": "0.4.0",
  "publisher": "azrael-ex-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:azrael.chat"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azraelViewContainer",
          "title": "Azrael",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "azraelViewContainer": [
        {
          "type": "webview",
          "id": "azrael.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Azrael Shared Environment",
      "properties": {
        "azrael.sharedEnvironment.repository": {
          "type": "string",
          "default": "",
          "description": "Git URL or local path of the shared Azrael environment repository."
        },
        "azrael.sharedEnvironment.ref": {
          "type": "string",
          "default": "main",
          "description": "Git ref (branch, tag, or commit) to sync from the shared environment repository."
        },
        "azrael.instructions.repository": {
          "description": "GitHub repository containing versioned Azrael instruction releases (owner/name).",
          "default": "felrer/Azrael",
          "type": "string"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "azrael.manageAccounts",
          "when": "false"
        },
        {
          "command": "azrael.devinAccount",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "azrael.openSidebar",
        "title": "Open Azrael Chat",
        "category": "Azrael"
      },
      {
        "command": "azrael.rootResume",
        "title": "루트 재개 예약",
        "category": "Azrael"
      },
      {
        "command": "azrael.usage",
        "title": "계정 및 사용량",
        "category": "Azrael"
      },
      {
        "command": "azrael.devinAccount",
        "title": "계정 및 사용량 열기 (Devin)",
        "category": "Azrael"
      },
      {
        "command": "azrael.manageAccounts",
        "title": "계정 및 사용량 관리",
        "category": "Azrael"
      },
      {
        "command": "azrael.apiConnections",
        "title": "API 연결 관리",
        "category": "Azrael"
      },
      {
        "command": "azrael.accountQuickPick",
        "title": "Switch OpenAI Account",
        "category": "Azrael"
      },
      {
        "command": "azrael.refreshAccounts",
        "title": "Refresh OpenAI Accounts",
        "category": "Azrael"
      },
      {
        "command": "azrael.openCodex",
        "title": "Open Azrael Sidebar",
        "category": "Azrael"
      },
      {
        "command": "azrael.openCodexSettings",
        "title": "Open Azrael Settings",
        "category": "Azrael"
      },
      {
        "command": "azrael.syncSharedEnvironment",
        "title": "Sync Shared Environment",
        "category": "Azrael"
      },
      {
        "command": "azrael.fetchSharedPlaybook",
        "title": "Fetch Shared Playbook",
        "category": "Azrael"
      },
      {
        "category": "Azrael",
        "command": "azrael.instructions",
        "title": "지침 문서"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:incremental": "node scripts/build-incremental.cjs",
    "test": "npm run build:incremental && node scripts/run-tests.cjs current",
    "test:compiled": "node scripts/run-tests.cjs current",
    "test:current": "npm run build:incremental && node scripts/run-tests.cjs current",
    "test:standalone": "npm run build:incremental && node scripts/run-tests.cjs standalone",
    "test:all": "npm run build:incremental && node scripts/run-tests.cjs all",
    "test:current:compiled": "node scripts/run-tests.cjs current",
    "test:standalone:compiled": "node scripts/run-tests.cjs standalone",
    "test:all:compiled": "node scripts/run-tests.cjs all",
    "test:serial": "node scripts/run-tests.cjs all --serial",
    "package": "npm run build && vsce package --out"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "yauzl": "3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felrer/Azrael.git"
  },
  "homepage": "https://github.com/felrer/Azrael"
}
